NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Without this, src/lib/mail/mailer.ts logs every email to the server
# console instead of sending it — password resets, booking confirmations,
# and notifications will silently never reach a real inbox.
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=info@sportonica.com

# Cloudflare Turnstile (SEC-04). Set both together: with only the secret,
# phone signup rejects every attempt; with neither, auth calls go out
# without a CAPTCHA token (fine only while Supabase's CAPTCHA setting is
# off). The same secret also goes in Supabase > Auth > Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# SMS for phone verification codes (SEC-03) — see src/lib/phone/sms.ts.
# Unset: no codes, phone numbers are saved unverified (can't claim walk-in
# tournament entries). "console" prints codes to the server log (dev only).
SMS_PROVIDER=

# Push notifications (src/lib/push/fcm.ts): the Firebase service-account
# JSON for project sportonica-3ee6e, on one line. Server-only; never
# prefix it with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Shared secret the Supabase database webhook sends to /api/push
# (compared in constant time). Any long random string; set the same value
# in the webhook's header config.
PUSH_WEBHOOK_SECRET=your-long-random-string
