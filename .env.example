NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Without this, src/lib/mail/mailer.ts logs every email to the server
# console instead of sending it — password resets, booking confirmations,
# and notifications will silently never reach a real inbox.
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=info@sportonica.com

# Cloudflare Turnstile (SEC-04). Set both together: with only the secret,
# phone signup rejects every attempt; with neither, auth calls go out
# without a CAPTCHA token (fine only while Supabase's CAPTCHA setting is
# off). The same secret also goes in Supabase > Auth > Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
